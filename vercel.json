{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run site:build",
  "outputDirectory": "site/dist",
  "redirects": [
    { "source": "/wall", "destination": "/advisories/", "permanent": true },
    { "source": "/advisories/:id", "destination": "/advisories/?id=:id", "permanent": false },
    { "source": "/packages/:name", "destination": "/packages/?name=:name", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
