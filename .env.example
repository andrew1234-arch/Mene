# Never commit real keys. Copy to .env and fill in testnet-only keys.
MENE_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
MENE_WS_URL=wss://rpc.tiramisu.db-chain.testnet.arkiv.network
# Demo witnesses (3 team-controlled testnet wallets)
MENE_ISSUER_A_KEY=
MENE_ISSUER_B_KEY=
MENE_ISSUER_C_KEY=
# Untrusted wallet used for the forgery demo
MENE_FORGER_KEY=
# Any wallet; used by `mene keepalive`
MENE_KEEPER_KEY=
# Key used by `mene publish` / `mene attest`
MENE_ISSUER_KEY=
