---
import Logo from "../components/Logo.astro"
import { REPO } from "../config"
import "../styles/global.css"
interface Props {
  title: string
  description?: string
  active?: string
}
const {
  title,
  description = "Mene tells you if your project uses a hijacked npm package, and blocks it in CI.",
  active,
} = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const preview = import.meta.env.PUBLIC_MENE_PREVIEW === "1"
const links = [
  ["/check", "Check"],
  ["/advisories", "Advisories"],
  ["/setup", "Set up CI"],
  ["/trust", "Trust"],
]
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title === "Mene" ? "Mene — warnings that can't be erased" : `${title} · Mene`}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title === "Mene" ? "Mene" : `${title} · Mene`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(`${base}/og-image-1200x630.png`, Astro.site).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#0B0E17" />
  <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
  <link rel="manifest" href={`${base}/site.webmanifest`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script is:inline>
    try { const t = localStorage.getItem("mene:theme"); if (t) document.documentElement.dataset.theme = t } catch {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site">
    <a class="pill logo-pill brand" href={`${base}/`} aria-label="Mene home"><Logo class="lockup" /></a>
    <div class="pill nav-pill" id="nav-pill">
      <form class="search" role="search" action={`${base}/packages/`} method="get" id="search-form">
        <label class="sr" for="pkg-search">Search packages</label>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M7 1.5a5.5 5.5 0 0 1 4.39 8.82l3.15 3.15-1.06 1.06-3.15-3.15A5.5 5.5 0 1 1 7 1.5Zm0 1.5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"/></svg>
        <input id="pkg-search" name="name" type="search" placeholder="Search packages" autocomplete="off" list="pkg-list" spellcheck="false" />
        <datalist id="pkg-list"></datalist>
      </form>
      <nav class="main" id="nav" aria-label="Main">
        {links.map(([href, label]) => (
          <a href={`${base}${href}`} aria-current={active === href ? "page" : undefined}>{label}</a>
        ))}
        <a href={REPO} class="gh" aria-label="Mene on GitHub"><svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.71 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"/></svg><span>GitHub</span></a>
      </nav>
    </div>
    <button class="pill menu-btn" id="menu-btn" aria-expanded="false" aria-controls="nav-pill" aria-label="Menu"><span></span><span></span></button>
  </header>
  {preview && (
    <div class="preview-bar" role="note">
      <div class="wrap"><strong>Preview with sample data.</strong> These advisories are examples, not live records. Lockfile checks run for real against them.</div>
    </div>
  )}
  <main id="main"><slot /></main>
  <footer class="site">
    <div class="foot-card">
      <div class="foot-grid">
        <div class="foot-ci">
          <h4>Block hijacked packages in CI</h4>
          <div class="ci-field">
            <code id="ci-line">uses: andrew1234-arch/mene@v1</code>
            <button type="button" class="ci-copy" data-copy-from="ci-line" aria-label="Copy the Action line">Copy</button>
          </div>
          <p class="small muted"><a href={`${base}/setup`}>Full setup in under 2 minutes →</a></p>
        </div>
        <nav aria-label="Product">
          <h4>Product</h4>
          <ul>
            <li><a href={`${base}/check`}>Check a project</a></li>
            <li><a href={`${base}/advisories`}>Advisories</a></li>
            <li><a href={`${base}/packages`}>Packages</a></li>
            <li><a href={`${base}/setup`}>Set up CI</a></li>
          </ul>
        </nav>
        <nav aria-label="Trust">
          <h4>Trust</h4>
          <ul>
            <li><a href={`${base}/trust`}>How Mene earns trust</a></li>
            <li><a href={`${base}/witnesses`}>Witnesses</a></li>
          </ul>
        </nav>
        <nav aria-label="Project">
          <h4>Project</h4>
          <ul>
            <li><a href={REPO}>Docs (README)</a></li>
            <li><a href={`${REPO}/blob/main/LICENSE`}>License (MIT)</a></li>
            <li><a href={REPO}>GitHub</a></li>
          </ul>
        </nav>
        <div class="foot-social">
          <h4>Data lives on Arkiv</h4>
          <p class="small muted"><span class="net" id="net"><i></i><span>Connecting…</span></span></p>
          <div class="icons">
            <button class="icon" id="theme" aria-label="Toggle colour theme" title="Toggle theme"><svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1Zm0 1.5v11a5.5 5.5 0 0 1 0-11Z"/></svg></button>
          </div>
        </div>
      </div>
      <p class="disclaimer">Advisories are stored on Arkiv and read straight from your browser; there is no Mene server. Package names are trademarks of their owners and appear here only to identify affected software.</p>
      <a class="giant" href={`${base}/`} aria-label="Mene home"><Logo class="giant-logo" /></a>
    </div>
  </footer>
  <script>
    import { link, onConnection, packageHref, pkgNames, pub, savedWall, setConnection } from "../scripts/mene"

    document.getElementById("theme")!.addEventListener("click", () => {
      const root = document.documentElement
      const dark = root.dataset.theme ? root.dataset.theme === "dark" : !matchMedia("(prefers-color-scheme: light)").matches
      root.dataset.theme = dark ? "light" : "dark"
      try { localStorage.setItem("mene:theme", root.dataset.theme) } catch {}
    })

    const menu = document.getElementById("menu-btn")!
    menu.addEventListener("click", () => {
      const open = menu.getAttribute("aria-expanded") !== "true"
      menu.setAttribute("aria-expanded", String(open))
      document.getElementById("nav-pill")!.classList.toggle("open", open)
    })

    // Package suggestions come from the saved advisory snapshot: typing never touches the network.
    const list = document.getElementById("pkg-list")!
    const names = new Set((savedWall()?.statuses ?? []).flatMap((s) => pkgNames(s.advisory?.osv)))
    list.innerHTML = [...names].sort().map((n) => `<option value="${n.replace(/"/g, "&quot;")}"></option>`).join("")
    const form = document.getElementById("search-form") as HTMLFormElement
    form.addEventListener("submit", (e) => {
      e.preventDefault()
      const name = (form.elements.namedItem("name") as HTMLInputElement).value.trim()
      location.href = name ? packageHref(name) : link("packages")
    })

    const net = document.getElementById("net")!
    onConnection((c) => {
      net.className = `net ${c.ok ? "ok" : "down"}`
      net.querySelector("span")!.textContent = c.ok ? `Tiramisu · block ${c.block}` : "Arkiv unreachable · retrying"
    })
    const ping = () =>
      pub().getBlockNumber().then((b) => setConnection({ ok: true, block: b.toString() }), () => setConnection({ ok: false }))
    void ping()
    setInterval(() => { if (!document.hidden) void ping() }, 30_000)
  </script>
</body>
</html>
