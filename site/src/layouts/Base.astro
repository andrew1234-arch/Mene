---
import { TIRAMISU } from "@mene/sdk"
import { DOCS, REPO } from "../config"
import "../styles/global.css"
interface Props {
  title: string
  description?: string
  active?: string
  wide?: boolean
}
const {
  title,
  description = "Quorum-witnessed npm compromise advisories on Arkiv. Check your lockfile for poisoned packages.",
  active,
} = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const preview = import.meta.env.PUBLIC_MENE_PREVIEW === "1"
const links = [
  ["/wall", "The Wall"],
  ["/check", "Check"],
  ["/witnesses", "Witnesses"],
]
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title === "Mene" ? "Mene — the writing on the wall for poisoned packages" : `${title} · Mene`}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title === "Mene" ? "Mene" : `${title} · Mene`} />
  <meta property="og:description" content={description} />
  <meta name="theme-color" content="#f3ecff" />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script is:inline>
    try { const t = localStorage.getItem("mene:theme"); if (t) document.documentElement.dataset.theme = t } catch {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site">
    <div class="bar">
      <a class="brand" href={`${base}/`} aria-label="Mene home"><img src={`${base}/favicon.svg`} alt="" width="26" height="26" />mene</a>
      <nav class="main" id="nav" aria-label="Main">
        {links.map(([href, label]) => <a href={`${base}${href}`} aria-current={active === href ? "page" : undefined}>{label}</a>)}
        <a href={REPO}>Docs</a>
      </nav>
      <div class="tools">
        <span class="net" id="net" title="Connection to the Arkiv Tiramisu network"><i></i><span>Arkiv</span></span>
        <button class="btn wallet-btn" id="wallet-btn">Connect wallet</button>
      </div>
      <button class="menu-btn icon-btn btn" id="menu-btn" aria-expanded="false" aria-controls="nav" aria-label="Menu">☰</button>
    </div>
  </header>
  {preview && (
    <div class="preview-bar" role="note">
      <div class="wrap"><strong>Preview with sample data.</strong> These advisories and witnesses are examples, not live Arkiv records. Lockfile checks run for real against them. Wallet actions need the live site.</div>
    </div>
  )}
  <main id="main"><slot /></main>
  <footer class="site">
    <div class="wrap">
      <div class="foot-top">
        <div class="foot-tag">
          <a class="brand" href={`${base}/`}><img src={`${base}/favicon.svg`} alt="" width="22" height="22" />mene</a>
          <span>The writing on the wall for poisoned packages · MIT</span>
        </div>
        <p class="foot-quote">“Mene, Mene, Tekel, Upharsin.” Numbered, weighed, divided.</p>
      </div>
      <div class="orn" aria-hidden="true">) + (</div>
      <div class="foot-grid">
        <div>
          <a class="pill-link" href={REPO}>Source on GitHub ›</a>
          <div class="foot-tools">
            <button class="icon-btn btn" id="theme" aria-label="Toggle colour theme" title="Toggle theme">◐ Theme</button>
          </div>
        </div>
        <nav aria-label="Product">
          <h4>Product</h4>
          <ul>
            <li><a href={`${base}/wall`}>The Wall</a></li>
            <li><a href={`${base}/check`}>Check a lockfile</a></li>
            <li><a href={`${base}/witnesses`}>Witnesses</a></li>
          </ul>
        </nav>
        <nav aria-label="Developers">
          <h4>Developers</h4>
          <ul>
            <li><a href={DOCS.cli}>CLI</a></li>
            <li><a href={DOCS.action}>GitHub Action</a></li>
            <li><a href={DOCS.schema}>Data contract</a></li>
          </ul>
        </nav>
        <nav aria-label="Trust">
          <h4>Trust</h4>
          <ul>
            <li><a href={DOCS.trust}>Trust model</a></li>
            <li><a href={DOCS.threats}>Threat model</a></li>
            <li><a href={TIRAMISU.explorer}>Arkiv explorer</a></li>
          </ul>
        </nav>
      </div>
      <div class="orn" aria-hidden="true">) + (</div>
      <p class="disclaimer">Advisories live on Arkiv, the Web3 database, on the Tiramisu testnet. This site reads them straight from your browser; there is no Mene server. Package names are trademarks of their owners and appear here only to identify affected software.</p>
    </div>
  </footer>
  <script>
    import { pub, onConnection, setConnection, short, isTrusted, toast } from "../scripts/mene"
    import { connect, disconnect, hasWallet, onWallet } from "../scripts/wallet"

    document.getElementById("theme")!.addEventListener("click", () => {
      const root = document.documentElement
      const dark = root.dataset.theme ? root.dataset.theme === "dark" : !matchMedia("(prefers-color-scheme: light)").matches
      root.dataset.theme = dark ? "light" : "dark"
      try { localStorage.setItem("mene:theme", root.dataset.theme) } catch {}
    })

    const menu = document.getElementById("menu-btn")!
    menu.addEventListener("click", () => {
      const open = menu.getAttribute("aria-expanded") !== "true"
      menu.setAttribute("aria-expanded", String(open))
      document.getElementById("nav")!.classList.toggle("open", open)
    })

    const net = document.getElementById("net")!
    onConnection((c) => {
      net.className = `net ${c.ok ? "ok" : "down"}`
      net.querySelector("span")!.textContent = c.ok ? `Arkiv · #${c.block}` : "Arkiv offline"
      net.title = c.ok ? `Connected to Arkiv Tiramisu, block ${c.block}` : "Can't reach Arkiv — retrying"
    })
    const ping = () =>
      pub().getBlockNumber().then((b) => setConnection({ ok: true, block: b.toString() }), () => setConnection({ ok: false }))
    void ping()
    setInterval(() => { if (!document.hidden) void ping() }, 15_000)

    const wb = document.getElementById("wallet-btn") as HTMLButtonElement
    if (!hasWallet()) {
      wb.addEventListener("click", () => toast("No browser wallet found. Install MetaMask or Rabby to publish or confirm. Checking lockfiles needs no wallet.", "err"))
    } else {
      onWallet((a) => {
        wb.textContent = a ? `${short(a)}${isTrusted(a) ? " · witness" : ""}` : "Connect wallet"
        wb.classList.toggle("connected", !!a)
        wb.title = a ? "Click to disconnect" : "Connect a browser wallet to publish, attest or keep advisories alive"
      })
      wb.addEventListener("click", async () => {
        if (wb.classList.contains("connected")) return disconnect()
        try {
          await connect()
          toast("Wallet connected")
        } catch (err) {
          toast((err as Error).message.split("\n")[0]!, "err")
        }
      })
    }
  </script>
</body>
</html>
