---
import CheckPanel from "../components/CheckPanel.astro"
import Base from "../layouts/Base.astro"
const base = import.meta.env.BASE_URL.replace(/\/$/, "")

const values = [
  [
    "Can't be deleted",
    "Once a warning is confirmed, nobody can edit or remove it: not its author, not us, not a hacked account.",
    "delete",
  ],
  [
    "One hacked account can't fake or hide a warning",
    "Independent witnesses must agree before a warning counts, and before it can be withdrawn.",
    "hacked",
  ],
  [
    "Your code never leaves your machine",
    "Matching runs in your browser or your CI runner. Mene never sees your package list.",
    "privacy",
  ],
]
---
<Base title="Mene">
  <section class="panel hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>Warnings that can’t be erased.</h1>
        <p class="lede">Mene tells you if your project uses a hijacked npm package, and blocks it in CI. Warnings are confirmed by independent witnesses and stored where no one can delete them.</p>
      </div>
      <CheckPanel mode="hero" />
    </div>
  </section>

  <section class="wrap section latest" aria-labelledby="latest-h">
    <div class="section-head">
      <h2 id="latest-h">Latest advisories</h2>
      <a class="btn" href={`${base}/advisories`}>View all</a>
    </div>
    <div id="latest"><div class="sk-list"><div class="sk"></div><div class="sk"></div><div class="sk"></div></div></div>
    <div id="fresh"></div>
  </section>

  <section class="wrap values" aria-label="Why Mene">
    {values.map(([t, d, id]) => (
      <a class="card value" href={`${base}/trust#${id}`}>
        <h3>{t}</h3>
        <p>{d}</p>
        <span class="more">How this works →</span>
      </a>
    ))}
  </section>

  <section class="panel pink ci-strip" aria-labelledby="ci-h">
    <div class="wrap ci-grid">
      <div>
        <h2 id="ci-h">Protect your CI</h2>
        <p class="lede">Add one step to your GitHub workflow. The build fails if a hijacked version appears, and the job summary shows the fix.</p>
        <a class="btn primary" href={`${base}/setup`}>Full setup in 2 minutes</a>
      </div>
      <div class="snippet">
<pre><code id="ci-snippet">- uses: actions/checkout@v4
- uses: andrew1234-arch/mene@v1
  with:
    lockfile: package-lock.json</code></pre>
        <button class="btn" data-copy-from="ci-snippet">Copy</button>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(2.5rem, 7vw, 4.5rem) 0; border-radius: 0 0 36px 36px; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
  .hero h1 { font-size: clamp(2.5rem, 6.4vw, 4.6rem); line-height: 1.02; margin-bottom: 1rem; }
  .hero .lede { font-size: 1.08rem; margin: 0; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } }
  .latest h2 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .values { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; padding-bottom: clamp(3rem, 7vw, 4.5rem); }
  @media (max-width: 820px) { .values { grid-template-columns: 1fr; } }
  .value { color: inherit; text-decoration: none; display: grid; align-content: start; gap: .3rem; transition: border-color .15s, box-shadow .15s; }
  .value:hover { border-color: var(--line-2); box-shadow: var(--shadow-lg); }
  .value h3 { margin: 0; font-size: 1.1rem; }
  .value p { margin: 0; color: var(--muted); font-size: .92rem; }
  .value .more { margin-top: .5rem; color: var(--link); font-size: .85rem; font-weight: 600; }
  .ci-strip { border-radius: 36px; margin: 0 clamp(0px, 1.5vw, 16px); }
  .ci-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: center; }
  @media (max-width: 820px) { .ci-grid { grid-template-columns: 1fr; } }
  .ci-strip h2 { margin-top: 0; }
  .ci-strip .lede { margin: 0 0 1.2rem; }
  .snippet { position: relative; }
  .snippet pre { margin: 0; padding: 1.1rem 1.2rem; font-size: .85rem; background: #0b0e17; color: #e8ebf4; border-color: #222a3b; }
  .snippet .btn { position: absolute; top: .6rem; right: .6rem; padding: .3rem .8rem; font-size: .78rem; }
</style>

<script>
  import { advRow, errorHtml, freshnessHtml, isTest, publishedAt, watchWall } from "../scripts/mene"
  const out = document.getElementById("latest")!
  const fresh = document.getElementById("fresh")!
  watchWall(
    (w, f) => {
      // Real advisories only: test advisories appear on /advisories, never here.
      const rows = w.statuses
        .filter((s) => s.status === "ACTIVE" && s.advisory && !isTest(s.advisory.osv))
        .sort((a, b) => publishedAt(b) - publishedAt(a))
        .slice(0, 5)
      out.innerHTML = rows.length
        ? `<ul class="adv-list">${rows.map((s) => advRow(s)).join("")}</ul>`
        : `<div class="empty"><p><strong>No confirmed advisories right now.</strong></p><p class="muted">When witnesses confirm a hijacked package, it appears here. You can still check your project.</p></div>`
      fresh.innerHTML = freshnessHtml(w, f)
    },
    (err, retry) => {
      out.innerHTML = errorHtml(err)
      out.querySelector("[data-retry]")?.addEventListener("click", retry)
    },
  )
</script>
