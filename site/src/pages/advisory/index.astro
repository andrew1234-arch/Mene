---
import Base from "../../layouts/Base.astro"
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
---
<Base title="Advisory" active="/wall">
  <p class="crumb"><a href={`${base}/wall`}>← All advisories</a></p>
  <div id="out"><div class="sk-list"><div class="sk" style="height:140px"></div><div class="sk" style="height:260px"></div></div></div>
</Base>

<style is:global>
  .crumb { margin: 1.5rem 0 .5rem; }
  .ahead { display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; }
  .ahead h1 { margin: 0; font-size: clamp(1.9rem, 4.5vw, 3rem); }
  .summary { font-size: 1.2rem; margin: .6rem 0 .3rem; max-width: 70ch; }
  .layout { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr); gap: 1.2rem; margin-top: 1.5rem; align-items: start; }
  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; } }
  .stack { display: grid; gap: 1.2rem; }
  .fixbox { border-color: var(--ok); }
  .fixbox h3 { color: var(--ok); }
  dl.kv { display: grid; grid-template-columns: max-content 1fr; gap: .45rem 1rem; margin: 0; }
  dl.kv dt { color: var(--muted); font-size: .88rem; }
  dl.kv dd { margin: 0; overflow-wrap: anywhere; }
  .meter { display: flex; gap: .3rem; margin: .5rem 0 .3rem; }
  .meter i { flex: 1; height: .5rem; border-radius: 999px; background: var(--line); }
  .meter i.on { background: var(--gold); }
  .wlist { list-style: none; padding: 0; margin: .6rem 0 0; display: grid; gap: .45rem; font-size: .9rem; }
  .wlist li { display: flex; justify-content: space-between; gap: .5rem; align-items: center; }
  .v-confirm { color: var(--gold); } .v-withdraw { color: var(--muted); } .v-none { color: var(--muted); opacity: .7; }
  .badges { display: flex; gap: .45rem; flex-wrap: wrap; }
  .timeline { list-style: none; padding: 0; margin: 0; border-left: 2px solid var(--line); }
  .timeline li { position: relative; padding: .1rem 0 1rem 1.1rem; }
  .timeline li::before { content: ""; position: absolute; left: -7px; top: .5rem; width: 12px; height: 12px; border-radius: 50%; background: var(--gold); }
  .timeline li.withdraw::before { background: var(--muted); }
  .timeline li.gone::before { background: var(--red); }
  .actions { display: grid; gap: .5rem; }
  .actions .row-actions { margin: 0; }
  details.card > summary { cursor: pointer; font-weight: 500; }
  details pre { max-height: 420px; }
  .affected-mini { display: grid; gap: .4rem; }
  #mine-out:empty { display: none; }
</style>

<script>
  import { attest, attestationQuery, BURN_ADDRESS, explorer, isSafeUrl, keepalive, readAdvisory, TIRAMISU, type AdvisoryStatus, type AdvisoryRecord, parseLockfile, matchLockfile, recommendedOf, severityOf, sourceLabel } from "@mene/sdk"
  import { addrHtml, affectedText, route, DOCS, blocksToHuman, chip, esc, errorHtml, fmtDate, getTrust, loadWall, pub, sevBadge, store, toast, witnessName } from "../../scripts/mene"
  import { connectedAddress, hasWallet, isWitness, onWallet, wallet, withTx } from "../../scripts/wallet"

  const out = document.getElementById("out")!
  // ?key=0x… on the live site; #0x… in preview bundles, where pages are plain files.
  const key = (new URLSearchParams(location.search).get("key") ?? location.hash.slice(1))?.toLowerCase() || undefined
  let head = 0n
  let adv: AdvisoryRecord | null = null
  let s: AdvisoryStatus | undefined
  let retryTimer: ReturnType<typeof setTimeout> | undefined
  let watching = false

  async function load(fresh = false) {
    clearTimeout(retryTimer)
    if (!key || !/^0x[0-9a-f]{64}$/.test(key)) {
      out.innerHTML = `<div class="empty"><p><strong>No advisory selected.</strong></p><p class="muted">Open one from <a href="${route("wall")}">the wall</a>.</p></div>`
      return
    }
    try {
      const [wall, h, a] = await Promise.all([loadWall({ fresh }), pub().getBlockNumber(), readAdvisory(pub(), key)])
      head = h
      adv = a
      s = wall.statuses.find((x) => x.key === key)
      render()
    } catch (err) {
      out.innerHTML = errorHtml(err)
      out.querySelector("[data-retry]")?.addEventListener("click", () => void load(true))
      retryTimer = setTimeout(() => void load(true), 10_000)
    }
  }

  function render() {
    const record = adv ?? s?.advisory
    const o = record?.osv
    const trust = getTrust()
    document.title = `${o?.id ?? "Advisory"} · Mene`
    const sealed = adv && adv.owner.toLowerCase() === BURN_ADDRESS.toLowerCase()
    const latest = new Map((s?.witnesses ?? []).map((w) => [w.issuer, w]))
    const confirms = s?.confirmers.length ?? 0
    const k = s?.threshold ?? trust.threshold
    const rec = o ? recommendedOf(o) : undefined
    const fixCmd = rec ? `${o!.affected[0]!.package.name}@${rec}` : ""
    const src = o?.database_specific.mene.source
    const q = attestationQuery(pub(), trust.issuers[0]?.address ?? "0x0000000000000000000000000000000000000000").toString()
    const statusText: Record<string, string> = {
      ACTIVE: "Enough witnesses have confirmed this. Mene blocks matching installs.",
      PENDING: "Waiting for more witnesses. Not enforced yet.",
      WITHDRAWN: "Witnesses withdrew this advisory. It is kept for the record but no longer enforced.",
      MISSING: "The advisory was removed from Arkiv. Mene keeps enforcing what it saw.",
    }

    out.innerHTML = `
      <div class="ahead"><h1>${esc(o?.id ?? "Unknown advisory")}</h1>${s ? chip(s) : `<span class="chip PENDING">NOT ATTESTED</span>`}${sevBadge(o ? severityOf(o) : undefined)}${o ? `<span class="src-tag">${esc(sourceLabel(o))}</span>` : ""}</div>
      <p class="summary">${esc(o?.summary ?? "This advisory's content isn't readable.")}</p>
      <p class="small muted">${o?.published ? `Published ${esc(fmtDate(o.published))}` : ""}${o?.aliases?.length ? ` · Also known as ${o.aliases.map((a) => `<code>${esc(a)}</code>`).join(", ")}` : ""}</p>
      ${!adv ? `<div class="alarm">This advisory is no longer readable on Arkiv. It was deleted or has expired. ${record ? "Below is this browser's saved copy." : "Its original content is still in the chain history."}</div>` : ""}

      <div class="layout">
        <div class="stack">
          ${fixCmd ? `<section class="card fixbox"><h3>How to fix</h3><p>Install the safe version:</p><div class="cmd"><pre><code id="fixcmd">npm install ${esc(fixCmd)}</code></pre><button class="btn" data-copy-from="fixcmd">Copy</button></div><p class="small muted">If the package is a transitive dependency, pin it with <code>"overrides"</code> in <code>package.json</code>. <a href="${route("check")}">Check your lockfile</a> to get the exact fix.</p></section>` : ""}
          <section class="card">
            <h3>Affected</h3>
            ${(o?.affected ?? []).map((a) => `<dl class="kv">
              <dt>Package</dt><dd><code>${esc(a.package.name)}</code> <span class="muted small">npm</span></dd>
              <dt>Versions</dt><dd><code style="color:var(--red)">${esc(affectedText(a as never))}</code></dd>
              ${rec && a.package.name === o!.affected[0]!.package.name ? `<dt>Install instead</dt><dd><code style="color:var(--ok)">${esc(rec)}</code></dd>` : ""}
            </dl>`).join("<hr style='border:0;border-top:1px solid var(--line);margin:.8rem 0'>")}
            ${o?.details ? `<h3 style="margin-top:1.2rem">Details</h3><p class="details">${esc(o.details.split("\n---")[0])}</p>` : ""}
            ${src ? `<p class="small muted">Mirrored as-is from <a href="${esc(src.repo)}/blob/main/${esc(src.path)}" rel="noopener" target="_blank">${esc(src.path)}</a> in OpenSSF malicious-packages (${esc(src.license)}). Mene removed only the credits block, which holds personal contact details.</p>` : ""}
            ${o?.references?.length ? `<h3 style="margin-top:1.2rem">References</h3><ul class="small">${o.references.map((r) => `<li>${isSafeUrl(r.url) ? `<a href="${esc(r.url)}" rel="noopener noreferrer" target="_blank">${esc(r.url.replace(/^https?:\/\//, ""))}</a>` : `<code>${esc(r.url)}</code>`} <span class="muted">${esc(r.type.toLowerCase())}</span></li>`).join("")}</ul>` : ""}
          </section>
          <section class="card">
            <h3>Am I affected?</h3>
            <div class="affected-mini">
              <p class="small muted">Choose a <code>package-lock.json</code>. It's checked in this page and never uploaded.</p>
              <input type="file" id="mine" accept=".json,application/json" aria-label="Choose package-lock.json" />
              <div id="mine-out"></div>
            </div>
          </section>
          <section class="card">
            <h3>History</h3>
            <ol class="timeline">
              ${record ? `<li><strong>Inscribed</strong> by ${esc(witnessName(record.creator, trust) ?? "")} ${addrHtml(record.creator)}<div class="small muted">block ${record.createdAt} · ${addrHtml(key!, "entity", "entity")}</div></li>` : ""}
              ${(s ? [...new Set([...s.witnesses, ...s.vanished])] : []).sort((a, b) => a.createdAt - b.createdAt).map((w) => {
                const gone = s!.vanished.some((v) => v.key === w.key)
                return `<li class="${w.verdict} ${gone ? "gone" : ""}"><strong>${w.verdict === "confirm" ? "Confirmed" : "Withdrawn"}</strong> by ${esc(witnessName(w.issuer, trust) ?? "")} ${addrHtml(w.issuer)}
                  <div class="small muted">block ${w.createdAt} · ${addrHtml(w.key, "entity", "attestation")}${w.reason ? ` · “${esc(w.reason)}”` : ""}</div>
                  ${gone ? `<div class="small error">Deleted from Arkiv. Still counted, because this browser saw it.</div>` : ""}</li>`
              }).join("")}
            </ol>
          </section>
        </div>

        <aside class="stack">
          <section class="card">
            <h3>Witnesses</h3>
            <p class="small muted">${s ? statusText[s.status] : "No trusted witness has attested to this advisory."}</p>
            <div class="meter" aria-label="${confirms} of ${k} confirmations">${Array.from({ length: Math.max(k, trust.issuers.length) }, (_, i) => `<i class="${i < confirms ? "on" : ""}"></i>`).join("")}</div>
            <p class="small">${confirms} confirm now · ${k} needed${s?.activated && confirms < k && s.status === "ACTIVE" ? " · stays active until a withdrawal quorum" : ""}</p>
            <ul class="wlist">${trust.issuers.map((i) => {
              const w = latest.get(i.address.toLowerCase())
              return `<li><span>${esc(i.name || "Witness")} ${addrHtml(i.address)}</span><span class="v-${w?.verdict ?? "none"}">${w ? (w.verdict === "confirm" ? "✓ confirmed" : "✗ withdrew") : "—"}</span></li>`
            }).join("")}</ul>
          </section>
          <section class="card actions" id="actions"></section>
          <section class="card">
            <h3>On Arkiv</h3>
            <div class="badges">
              ${adv?.readonly ? `<span class="seal" title="readonly: content can never change">Content frozen</span>` : ""}
              ${sealed ? `<span class="seal" title="Owned by the burn address 0x…dEaD: nobody can delete it">Sealed</span>` : adv ? `<span class="seal off" title="The owner can still delete it">Not sealed</span>` : ""}
              <span class="seal off" id="keeper" hidden></span>
            </div>
            <dl class="kv small" style="margin-top:.8rem">
              ${adv ? `<dt>Expires in</dt><dd>${blocksToHuman(BigInt(adv.expiresAt) - head)} <span class="muted">(block ${adv.expiresAt})</span></dd>` : ""}
              <dt>Entity</dt><dd>${addrHtml(key!, "entity")}</dd>
              ${adv ? `<dt>Owner</dt><dd>${addrHtml(adv.owner)}</dd>` : ""}
            </dl>
          </section>
        </aside>
      </div>

      <details class="card" style="margin-top:1.2rem">
        <summary>Verify it yourself</summary>
        <p class="small muted">Don't trust this page. Run the same reads against Arkiv.</p>
<pre><code>// @arkiv-network/sdk
const advisory = await pub.getEntity("${esc(key!)}")
const atts = await pub.select("*")
  .where(and(eq("project", "mene-v1"), eq("type", "attestation")))
  .createdBy(WITNESS).limit(200).fetch()   // repeat per witness

# raw JSON-RPC
curl -s ${TIRAMISU.rpcUrl} -H 'content-type: application/json' -d '{
  "jsonrpc":"2.0","id":1,"method":"arkiv_query",
  "params":["${esc(q.replace(/'/g, "'\"'\"'"))}",{"select":{"key":true,"attributes":true,"payload":true}}]}'</code></pre>
      </details>
      ${o ? `<details class="card" style="margin-top:.8rem"><summary>Raw OSV JSON</summary><pre><code>${esc(JSON.stringify(o, null, 2))}</code></pre><button class="btn" id="dl-osv">Download</button></details>` : ""}
    `
    renderActions()
    wireMine()
    document.getElementById("dl-osv")?.addEventListener("click", () => {
      const a = Object.assign(document.createElement("a"), { href: URL.createObjectURL(new Blob([JSON.stringify(o, null, 2)], { type: "application/json" })), download: `${o!.id}.osv.json` })
      a.click()
    })
    if (adv && !watching) {
      watching = true
      keptAliveBy(adv)
    }
  }

  function renderActions() {
    const el = document.getElementById("actions")
    if (!el) return
    if (!adv) {
      el.innerHTML = `<h3>Actions</h3><p class="small muted">This advisory can't be acted on because it is no longer on Arkiv.</p>`
      return
    }
    const me = connectedAddress()
    const myLatest = me ? s?.witnesses.find((w) => w.issuer === me) : undefined
    const witnessBtns = isWitness()
      ? `<div class="row-actions">
          <button class="btn primary" id="act-confirm" ${myLatest?.verdict === "confirm" ? "disabled" : ""}>${myLatest?.verdict === "confirm" ? "✓ You confirmed" : "Confirm"}</button>
          <button class="btn" id="act-withdraw" ${myLatest?.verdict === "withdraw" ? "disabled" : ""}>${myLatest?.verdict === "withdraw" ? "You withdrew" : "Withdraw"}</button>
        </div>
        <form class="withdraw-form" id="withdraw-form" hidden>
          <label class="small muted" for="withdraw-reason">Why are you withdrawing it? This is shown publicly.</label>
          <input id="withdraw-reason" maxlength="200" placeholder="e.g. false positive: 5.6.1 was a clean re-publish" />
          <div class="row-actions"><button class="btn danger" type="submit" id="withdraw-go">Withdraw advisory</button><button class="btn" type="button" id="withdraw-cancel">Cancel</button></div>
        </form>`
      : me
        ? `<p class="small muted">Your wallet isn't one of your trusted witnesses, so you can't confirm or withdraw. Anyone can keep this advisory alive.</p>`
        : ""
    el.innerHTML = `<h3>Actions</h3>
      ${!hasWallet() ? `<p class="small muted">Connect a browser wallet to confirm, withdraw or keep this advisory alive. You can also use the <a href="${DOCS.cli}">CLI</a>.</p>` : !me ? `<p class="small muted">Connect your wallet (top right) to act on this advisory.</p>` : witnessBtns}
      ${hasWallet() && me ? `<div class="row-actions"><button class="btn" id="act-keep">Keep alive 365 days</button></div><p class="small muted">Any wallet can pay for Lifetime Extension. Nobody can change the content.</p>` : ""}`
    const after = async (msg: string) => {
      toast(msg)
      store.del("mene:wall", "session")
      await load(true)
    }
    document.getElementById("act-confirm")?.addEventListener("click", (e) =>
      void withTx(e.currentTarget as HTMLButtonElement, "Confirming", async () => {
        await attest(await wallet(), key!, "confirm")
        await after("Confirmation written to Arkiv")
      }))
    const wf = document.getElementById("withdraw-form") as HTMLFormElement | null
    document.getElementById("act-withdraw")?.addEventListener("click", () => {
      if (!wf) return
      wf.hidden = false
      ;(document.getElementById("withdraw-reason") as HTMLInputElement).focus()
    })
    document.getElementById("withdraw-cancel")?.addEventListener("click", () => wf && (wf.hidden = true))
    wf?.addEventListener("submit", (e) => {
      e.preventDefault()
      const reason = (document.getElementById("withdraw-reason") as HTMLInputElement).value.trim()
      void withTx(document.getElementById("withdraw-go") as HTMLButtonElement, "Withdrawing", async () => {
        await attest(await wallet(), key!, "withdraw", reason || undefined)
        await after("Withdrawal written to Arkiv")
      })
    })
    document.getElementById("act-keep")?.addEventListener("click", (e) =>
      void withTx(e.currentTarget as HTMLButtonElement, "Extending", async () => {
        const keys = [key!, ...(s?.witnesses.map((w) => w.key) ?? [])]
        const r = await keepalive(pub(), await wallet(), keys, 365)
        await after(r.extended.length ? `Extended ${r.extended.length} entities` : "Already alive for at least 365 days")
      }))
  }

  function wireMine() {
    const input = document.getElementById("mine") as HTMLInputElement | null
    input?.addEventListener("change", async () => {
      const f = input.files?.[0]
      const res = document.getElementById("mine-out")!
      if (!f || !adv && !s?.advisory) return
      try {
        const hits = matchLockfile(parseLockfile(await f.text()), [{ key: key!, status: s?.label ?? "ACTIVE", advisory: (adv ?? s!.advisory!).osv }])
        const enforced = !!s?.enforced
        res.innerHTML = hits.length && !enforced
          ? `<div class="result"><strong>Contains a listed version, but not blocked.</strong> ${hits.map((h) => `<code>${esc(h.package)}@${esc(h.installed)}</code>`).join(", ")} matches, but this advisory is ${esc(s?.label ?? "not attested by your witnesses")}, so Mene doesn't enforce it.</div>`
          : hits.length
          ? `<div class="result bad"><strong>Affected.</strong> ${hits.map((h) => `<code>${esc(h.package)}@${esc(h.installed)}</code> at <code>${esc(h.path)}</code>`).join(", ")}${hits[0]!.safeVersion ? `. Upgrade to <code>${esc(hits[0]!.safeVersion)}</code>.` : ""}</div>`
          : `<div class="result good"><strong>Not affected.</strong> ${esc(f.name)} doesn't contain an affected version.</div>`
      } catch {
        res.innerHTML = `<p class="error small">That file isn't a readable package-lock.json.</p>`
      }
    })
  }

  // "Kept alive by": replay ExpiryExtended events for this entity and read each tx sender.
  function keptAliveBy(a: AdvisoryRecord) {
    const el = document.getElementById("keeper")
    if (!el) return
    const stop = pub().watchEntityEvents({
      fromBlock: BigInt(a.createdAt),
      onExpiryExtended: async (ev) => {
        if (ev.entityKey.toLowerCase() !== key) return
        try {
          const tx = await pub().getTransaction({ hash: ev.transactionHash })
          el.hidden = false
          el.className = "seal"
          el.innerHTML = `Kept alive by <a class="addr" href="${explorer.address(tx.from)}" target="_blank" rel="noopener">${tx.from.slice(0, 6)}…${tx.from.slice(-4)}</a>`
        } catch {}
      },
      onError: () => stop(),
    })
    setTimeout(stop, 20000)
  }

  onWallet(() => renderActions())
  void load()
</script>
