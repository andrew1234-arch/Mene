---
// Advisory pages moved to /advisories/?id=…; ?key=0x… (and #0x…) links still resolve.
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Advisory · Mene</title>
  <link rel="canonical" href={`${base}/advisories/`} />
  <script is:inline define:vars={{ base }}>
    const key = new URLSearchParams(location.search).get("key") || location.hash.slice(1)
    location.replace(`${base}/advisories/${key ? `?id=${encodeURIComponent(key)}` : ""}`)
  </script>
</head>
<body><p><a href={`${base}/advisories/`}>Advisories have moved here.</a></p></body>
</html>
