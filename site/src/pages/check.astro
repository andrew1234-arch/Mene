---
import CheckPanel from "../components/CheckPanel.astro"
import Base from "../layouts/Base.astro"
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
---
<Base title="Is my project affected?" active="/check" description="Check a package-lock.json or a public GitHub repo for hijacked npm packages, privately, in your browser.">
  <section class="panel flat page-head">
    <div class="wrap center">
      <h1>Is my project affected?</h1>
      <p class="lede">Drop your <code>package-lock.json</code> or paste a public GitHub repo. You get a list of hijacked packages and the exact versions to install instead.</p>
    </div>
  </section>
  <div class="wrap narrow">
    <CheckPanel mode="full" />
    <p class="small muted after">Want this on every build? <a href={`${base}/setup`}>Set up CI in 2 minutes →</a></p>
  </div>
</Base>
<style>
  .narrow { max-width: 860px; padding-top: 1.5rem; }
  .after { text-align: center; margin-top: 1.5rem; }
</style>
