---
// The Wall became /advisories. Old links keep working.
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Advisories · Mene</title>
  <meta http-equiv="refresh" content={`0; url=${base}/advisories/`} />
  <link rel="canonical" href={`${base}/advisories/`} />
  <script is:inline define:vars={{ base }}>location.replace(`${base}/advisories/${location.search}${location.hash}`)</script>
</head>
<body><p><a href={`${base}/advisories/`}>Advisories have moved here.</a></p></body>
</html>
