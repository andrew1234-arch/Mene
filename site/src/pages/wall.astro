---
import Base from "../layouts/Base.astro"
---
<Base title="Advisories" active="/wall" description="Every npm compromise advisory your witnesses agree on, read live from Arkiv.">
  <div class="head">
    <div>
      <h1>The Wall</h1>
      <p class="muted">Every npm compromise advisory your witnesses have weighed. Status comes from the quorum, not from whoever wrote the advisory.</p>
    </div>
  </div>

  <form id="filters" class="filters" onsubmit="return false" role="search">
    <input type="search" name="q" class="search" placeholder="Search packages or advisory IDs…" autocomplete="off" aria-label="Search packages or advisory IDs" />
    <div class="tabs" role="tablist" id="tabs">
      <button type="button" role="tab" data-status="all" aria-selected="true">All <span></span></button>
      <button type="button" role="tab" data-status="ACTIVE" aria-selected="false">Active <span></span></button>
      <button type="button" role="tab" data-status="PENDING" aria-selected="false">Pending <span></span></button>
      <button type="button" role="tab" data-status="WITHDRAWN" aria-selected="false">Withdrawn <span></span></button>
      <button type="button" role="tab" data-status="MISSING" aria-selected="false">Missing <span></span></button>
    </div>
    <details class="more">
      <summary>Filters</summary>
      <div class="row">
        <label>Minimum severity
          <select name="sev"><option value="1">Any</option><option value="2">Medium+</option><option value="3">High+</option><option value="4">Critical</option></select>
        </label>
        <label>Published since <input type="date" name="since" /></label>
        <label>Sort
          <select name="sort"><option value="new">Newest first</option><option value="sev">Most severe first</option></select>
        </label>
      </div>
      <p class="small muted">Severity and date run as range queries on Arkiv. Search runs only in your browser, so package names never go over the network.</p>
    </details>
  </form>

  <div id="alarms"></div>
  <div id="out"><div class="sk-list"><div class="sk"></div><div class="sk"></div><div class="sk"></div><div class="sk"></div></div></div>
  <p id="meta" class="small muted"></p>
</Base>

<style>
  .head { padding-top: 2rem; }
  .filters { display: grid; gap: .8rem; margin: 1.5rem 0 1rem; }
  .search { width: 100%; font-size: 1.05rem; padding: .75rem 1rem; border-radius: 12px; }
  .tabs { display: flex; gap: .3rem; flex-wrap: wrap; }
  .tabs button { border-radius: 999px; font-size: .88rem; padding: .3rem .8rem; }
  .tabs button[aria-selected="true"] { background: var(--gold); color: var(--gold-ink); border-color: var(--gold); }
  .tabs span { opacity: .7; font-family: var(--mono); font-size: .78rem; margin-left: .15rem; }
  .more summary { cursor: pointer; color: var(--muted); font-size: .9rem; }
  .more .row { margin-top: .6rem; }
  #alarms { display: grid; gap: .6rem; margin-bottom: 1rem; }
</style>

<script>
  import { and, eq, gte } from "@arkiv-network/sdk/query"
  import { i32, u64 } from "@arkiv-network/sdk/attr"
  import { PROJECT, type AdvisoryStatus } from "@mene/sdk"
  import { addrHtml, advCard, advisoryUrl, esc, errorHtml, pub, watchWall, witnessName, type Wall } from "../scripts/mene"

  const form = document.getElementById("filters") as HTMLFormElement
  const out = document.getElementById("out")!
  const meta = document.getElementById("meta")!
  const alarms = document.getElementById("alarms")!
  const tabs = document.getElementById("tabs")!
  let wall: Wall | undefined
  let status = new URLSearchParams(location.search).get("status") ?? "all"
  let rangeKeys: Set<string> | null = null
  let rangeSev = 1
  let rangeSince = 0
  const SEV = ["low", "medium", "high", "critical"]
  const sevOf = (s: AdvisoryStatus) => SEV.indexOf(s.advisory?.osv.database_specific.severity ?? "low") + 1

  /**
   * Numeric range query on Arkiv, pinned per trusted witness with createdBy() like every read. It
   * decides for live advisories a witness created; anything else is decided from its OSV content.
   */
  async function runRangeQuery() {
    const fd = new FormData(form)
    rangeSev = Number(fd.get("sev"))
    const since = String(fd.get("since") || "")
    rangeSince = since ? Math.floor(Date.parse(since) / 1000) : 0
    if (rangeSev <= 1 && !rangeSince) return (rangeKeys = null)
    const preds = [eq("project", PROJECT), eq("type", "advisory"), gte("severity", i32(rangeSev))]
    if (rangeSince) preds.push(gte("publishedAt", u64(BigInt(rangeSince))))
    const keys = new Set<string>()
    for (const w of wall?.trust.issuers ?? []) {
      let page = await pub().select({ key: true }).where(and(preds)).createdBy(w.address as `0x${string}`).limit(200).fetch()
      for (;;) {
        for (const e of page.entities) keys.add(e.key.toLowerCase())
        if (!page.hasNextPage()) break
        page = await page.next()
      }
    }
    rangeKeys = keys
  }
  function inRangeFilter(s: AdvisoryStatus): boolean {
    if (!rangeKeys) return true
    const a = s.advisory
    const queried = a && !s.advisoryGone && wall!.trust.issuers.some((i) => i.address.toLowerCase() === a.creator)
    if (queried) return rangeKeys.has(s.key)
    if (!a) return true // content unknown: never hide an enforced row
    return sevOf(s) >= rangeSev && (!rangeSince || Date.parse(a.osv.published) / 1000 >= rangeSince)
  }

  function render() {
    if (!wall) return
    const fd = new FormData(form)
    const q = String(fd.get("q") || "").trim().toLowerCase()
    const base = wall.statuses.filter((s) => {
      if (!inRangeFilter(s)) return false
      if (!q) return true
      const o = s.advisory?.osv
      return !!o && (o.id.toLowerCase().includes(q) || o.summary.toLowerCase().includes(q) || (o.aliases ?? []).some((a) => a.toLowerCase().includes(q)) || o.affected.some((a) => a.package.name.toLowerCase().includes(q)))
    })
    for (const b of tabs.querySelectorAll<HTMLButtonElement>("button")) {
      const st = b.dataset.status!
      b.setAttribute("aria-selected", String(st === status))
      b.querySelector("span")!.textContent = String(st === "all" ? base.length : base.filter((s) => s.status === st).length)
    }
    let rows = base.filter((s) => status === "all" || s.status === status)
    if (fd.get("sort") === "sev") rows = [...rows].sort((a, b) => sevOf(b) - sevOf(a))
    out.innerHTML = rows.length
      ? `<ul class="adv-list">${rows.map(advCard).join("")}</ul>`
      : `<div class="empty"><p><strong>${q ? `Nothing matches “${esc(q)}”.` : "Nothing here."}</strong></p><p class="muted">${q ? "Try another package name or advisory ID." : "Try another tab or clear the filters."}</p></div>`
  }

  watchWall(
    (w) => {
      wall = w
      meta.textContent = `Read live from Arkiv at block ${w.blockNumber} · ${w.trust.threshold}-of-${w.trust.issuers.length} witness quorum`
      alarms.innerHTML = w.statuses
        .flatMap((s) => [
          ...(s.status === "MISSING" ? [`<div class="alarm"><strong>Advisory removed from Arkiv:</strong> <a href="${advisoryUrl(s.key)}">${esc(s.advisory?.osv.id ?? s.key)}</a> was deleted or expired. Mene still enforces it (${esc(s.label)}).</div>`] : []),
          ...s.vanished.map((v) => `<div class="alarm"><strong>Confirmation deleted:</strong> ${esc(witnessName(v.issuer) ?? "A witness")} ${addrHtml(v.issuer)} deleted their ${esc(v.verdict)} on <a href="${advisoryUrl(s.key)}">${esc(s.advisory?.osv.id ?? s.key)}</a>. This browser saw it, so it still counts.</div>`),
        ])
        .join("")
      render()
    },
    (err, retry) => {
      out.innerHTML = errorHtml(err)
      out.querySelector("[data-retry]")?.addEventListener("click", retry)
    },
  )

  tabs.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-status]")
    if (!b) return
    status = b.dataset.status!
    const url = new URL(location.href)
    if (status === "all") url.searchParams.delete("status")
    else url.searchParams.set("status", status)
    history.replaceState(null, "", url)
    render()
  })
  form.addEventListener("input", async (e) => {
    const name = (e.target as HTMLInputElement).name
    if (name === "sev" || name === "since") {
      try {
        await runRangeQuery()
      } catch {
        out.innerHTML = errorHtml(new Error("network"))
        return
      }
    }
    render()
  })
</script>
